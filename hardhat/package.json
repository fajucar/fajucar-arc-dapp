{
  "name": "fajucar-v3-deploy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy:core": "npx hardhat run scripts/deployV3Core.cjs --network arcTestnet",
    "deploy:periphery": "npx hardhat run scripts/deployV3Periphery.cjs --network arcTestnet",
    "create:pool": "npx hardhat run scripts/createPoolAndInit.cjs --network arcTestnet",
    "create:pool:v3": "node scripts/runCreatePoolV3.cjs",
    "mint:position": "npx hardhat run scripts/mintPosition.cjs --network arcTestnet",
    "verify": "npx hardhat run scripts/verifyAddresses.cjs --network arcTestnet",
    "export:abis": "node scripts/exportAbis.cjs"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^3.0.0",
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
